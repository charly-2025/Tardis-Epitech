   "source": [
    "df = pd.read_csv(\"project_dataset.csv\", parse_dates=[\"Date\"])\n",
    "\n",
    "reference_date = \"2026-02-23\""
   ]
  },
  {
   "cell_type": "markdown",
   "id": "5eb3945e",
   "metadata": {},
   "source": [
    "calculate 10 years before and after"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "7632a099",
   "metadata": {},
   "outputs": [],
   "source": [
    "start_date = pd.to_datetime(reference_date) - pd.Timedelta(days=365*10)\n",
    "end_date = pd.to_datetime(reference_date) + pd.Timedelta(days=365*10)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "9de43e70",
   "metadata": {},
   "source": [
    "filter data within the 20 year "
